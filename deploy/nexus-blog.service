[Unit]
Description=Nexus Blog Gunicorn Service
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/nexus-blog/backend
Environment="DJANGO_SETTINGS_MODULE=blog_project.settings"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/opt/nexus-blog/backend/venv/bin/gunicorn blog_project.wsgi:application \
    --bind 127.0.0.1:8000 \
    --workers 2 \
    --timeout 120 \
    --access-logfile /var/log/nexus-blog/gunicorn-access.log \
    --error-logfile /var/log/nexus-blog/gunicorn-error.log \
    --log-level info
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target